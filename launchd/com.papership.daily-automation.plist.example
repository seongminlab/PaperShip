<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.papership.daily-automation</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__PAPERSHIP_ROOT__/scripts/run_all.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PAPERSHIP_ROOT__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/PaperShip/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/PaperShip/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
