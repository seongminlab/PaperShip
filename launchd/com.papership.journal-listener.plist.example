<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.papership.journal-listener</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__PAPERSHIP_ROOT__/projects/daily_paper_digest/telegram_listener.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PAPERSHIP_ROOT__/projects/daily_paper_digest</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/PaperShip/journal-listener.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/PaperShip/journal-listener.err.log</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
